opam-version: "2.0"
name: "numpy_checking"
version: "dev"
synopsis: "Z3-backed shape checker for numpy array programs"
maintainer: "Teddy Liu <theodoretliu@gmail.com>"
authors: "Teddy Liu <theodoretliu@gmail.com>"
homepage: "https://github.com/theodoretliu/thesis"
bug-reports: "https://github.com/theodoretliu/thesis/issues"
depends: [
  "astring" {= "0.8.5" & with-dev-setup}
  "base" {= "v0.17.3" & with-dev-setup}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "camlp-streams" {= "5.0.1" & with-dev-setup}
  "cmdliner" {= "2.1.1" & with-dev-setup}
  "compiler-cloning" {= "enabled"}
  "conf-bash" {= "1"}
  "conf-c++" {= "1.0"}
  "conf-gmp" {= "5"}
  "conf-llvm" {= "17"}
  "conf-pkg-config" {= "5"}
  "conf-python-3" {= "9.0.0"}
  "cppo" {= "1.8.0"}
  "csexp" {= "1.5.2" & with-dev-setup}
  "dune" {= "3.24.2"}
  "dune-build-info" {= "3.24.2" & with-dev-setup}
  "dune-configurator" {= "3.24.2" & with-dev-setup}
  "either" {= "1.0.0" & with-dev-setup}
  "fix" {= "20250919" & with-dev-setup}
  "fpath" {= "0.7.3" & with-dev-setup}
  "menhir" {= "20260209" & with-dev-setup}
  "menhirCST" {= "20260209" & with-dev-setup}
  "menhirGLR" {= "20260209" & with-dev-setup}
  "menhirLib" {= "20260209" & with-dev-setup}
  "menhirSdk" {= "20260209" & with-dev-setup}
  "ocaml" {= "5.5.1"}
  "ocaml-base-compiler" {= "5.5.1"}
  "ocaml-compiler" {= "5.5.1"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-version" {= "4.1.4" & with-dev-setup}
  "ocaml_intrinsics_kernel" {= "v0.17.2" & with-dev-setup}
  "ocamlbuild" {= "0.16.1" & with-dev-setup}
  "ocamlfind" {= "1.9.9~preview"}
  "ocamlformat" {= "0.29.0" & with-dev-setup}
  "ocamlformat-lib" {= "0.29.0" & with-dev-setup}
  "ocp-indent" {= "1.10.0" & with-dev-setup}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "6.2.0"}
  "ppxlib" {= "0.38.0"}
  "re" {= "1.14.0" & with-dev-setup}
  "sexplib0" {= "v0.17.0"}
  "stdio" {= "v0.17.0" & with-dev-setup}
  "stdlib-shims" {= "0.3.0"}
  "topkg" {= "1.1.1" & with-dev-setup}
  "uucp" {= "18.0.0" & with-dev-setup}
  "uuseg" {= "18.0.0" & with-dev-setup}
  "uutf" {= "1.0.4" & with-dev-setup}
  "z3" {= "4.16.0"}
  "zarith" {= "1.14"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/theodoretliu/thesis.git"
x-maintenance-intent: ["(latest)"]
license: "MIT"